{
  "desktop": {
    "backend": "cef"
  },
  "unstable": [
    "webgpu"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "deno.window",
      "deno.unstable",
      "deno.desktop"
    ]
  },
  "tasks": {
    "bundle": "deno bundle --platform browser --format esm --output dist/client.js src/client/main.ts",
    "dev": "deno run --allow-run --allow-read src/desktop/dev/main.ts",
    "build": "deno task bundle && deno desktop -o dist/deno-desktop-webgpu src/desktop/app.ts",
    "check": "deno task bundle && deno check --desktop src/desktop/app.ts src/desktop/dev/main.ts \"src/**/*.test.ts\"",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "verify": "deno task format:check && deno task lint && deno task check && deno task doc:lint && deno task test",
    "setup": "sh .githooks/setup.sh",
    "doc:lint": "deno doc --lint \"src/**/*.ts\"",
    "test": "deno test --no-check",
    "test:coverage": "deno test --no-check --coverage=coverage && deno coverage coverage",
    "fix": "deno fmt && deno lint --fix"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      ".agents",
      ".claude",
      "skills-lock.json"
    ]
  },
  "lint": {
    "exclude": [
      ".agents",
      ".claude"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.21"
  }
}
