#!/bin/sh
# Reject commit messages and identities that name an AI agent.
# See "Commit history" in AGENTS.md.

PATTERN="$(cat "$(dirname "$0")/agent-pattern")"

if grep -v '^#' "$1" | grep -E -i -q "$PATTERN"; then
  echo "commit-msg: the message names an agent or has an attribution line." >&2
  echo "Remove it. Agents must never appear in the commit history." >&2
  exit 1
fi

IDENTITY="$(git var GIT_AUTHOR_IDENT) $(git var GIT_COMMITTER_IDENT)"
if echo "$IDENTITY" | grep -E -i -q "$PATTERN"; then
  echo "commit-msg: the author or committer is an agent." >&2
  echo "Run 'deno task setup' to set the real user." >&2
  exit 1
fi
